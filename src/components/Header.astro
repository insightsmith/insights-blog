---
const base = import.meta.env.BASE_URL;
---
<header class="border-b border-gray-200 py-4 mb-10">
  <div class="max-w-3xl mx-auto px-6 flex items-center justify-between">
    <a href={base} class="text-xl font-bold tracking-tight text-gray-900 hover:text-blue-600 transition-colors">
      InsightsForge
    </a>
    <nav class="flex gap-6 text-sm text-gray-600">
      <a href={base} class="hover:text-blue-600 transition-colors">Home</a>
      <a href={`${base}/blog`} class="hover:text-blue-600 transition-colors">Blog</a>
    </nav>
  </div>
</header>
