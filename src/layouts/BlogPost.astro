---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title, description, pubDate, updatedDate, tags, author } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' });
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class="bg-white text-gray-900 font-sans">
    <Header />
    <main class="max-w-3xl mx-auto px-6 pb-20">
      <header class="mb-10">
        <div class="flex flex-wrap gap-2 mb-4">
          {tags.map((tag: string) => (
            <span class="text-xs bg-blue-100 text-blue-700 rounded-full px-2 py-0.5">{tag}</span>
          ))}
        </div>
        <h1 class="text-4xl font-bold text-gray-900 mb-4 leading-tight">{title}</h1>
        <p class="text-gray-500 text-sm">
          By {author} · <time>{formattedDate}</time>
          {updatedDate && <span> · Updated {updatedDate.toLocaleDateString('en-AU')}</span>}
        </p>
      </header>
      <article class="prose prose-gray max-w-none">
        <slot />
      </article>
    </main>
    <Footer />
  </body>
</html>
