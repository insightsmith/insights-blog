---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Blog"
      description="All posts on technology, philosophy, fitness, and culture."
    />
  </head>
  <body class="bg-white text-gray-900 font-sans">
    <Header />
    <main class="max-w-3xl mx-auto px-6 pb-20">
      <section class="mb-14">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">All Posts</h1>
        <p class="text-lg text-gray-600 leading-relaxed">
          {posts.length} post{posts.length !== 1 ? 's' : ''} on technology, philosophy, fitness, and culture.
        </p>
      </section>
      <section>
        <div class="grid gap-6">
          {posts.map(post => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              slug={post.slug}
            />
          ))}
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
