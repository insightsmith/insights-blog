---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostsSection from '../components/PostsSection.tsx';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = posts.flatMap(post => post.data.tags);
const tagCounts = allTags.reduce((acc, tag) => {
  acc[tag] = (acc[tag] || 0) + 1;
  return acc;
}, {});
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="InsightsForge"
      description="A blog on technology, philosophy, fitness, and culture."
    />
  </head>
  <body class="bg-white text-gray-900 font-sans">
    <Header />
    <main class="max-w-3xl mx-auto px-6 pb-20">
      <section class="mb-14">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">InsightsForge</h1>
        <p class="text-lg text-gray-600 leading-relaxed max-w-2xl">
          A forge for ideas across technology, philosophy, fitness, and culture.
          Written from Brisbane, Australia.
        </p>
      </section>
      <section>
        <PostsSection posts={posts} tagCounts={tagCounts} client:load />
      </section>
    </main>
    <Footer />
  </body>
</html>
